{
  "schema_version": 3,
  "rules": [
    {
      "id": "existing-stack-first",
      "priority": 1,
      "text": "Respect the host project's existing design, chart and motion owners before adding a new one."
    },
    {
      "id": "minimum-set",
      "priority": 2,
      "text": "Use the minimum number of libraries needed for explicit task capabilities."
    },
    {
      "id": "role-ownership",
      "priority": 3,
      "text": "Give each major UI role one explicit owner."
    },
    {
      "id": "structured-input-first",
      "priority": 4,
      "text": "Prefer HostProfile and TaskProfile evidence; use task text only as a backward-compatible inference path."
    },
    {
      "id": "framework-compatibility",
      "priority": 5,
      "text": "Reject candidates whose declared framework support excludes the host framework."
    },
    {
      "id": "native-motion-first",
      "priority": 6,
      "text": "Prefer existing CSS or component-native motion before adding a timeline engine."
    },
    {
      "id": "rive-purpose",
      "priority": 7,
      "text": "Use Rive only for meaningful interactive vector graphics with confirmed asset rights."
    },
    {
      "id": "react-bits-no-vendor",
      "priority": 8,
      "text": "Never vendor or redistribute React Bits component source from OrchestrUI."
    },
    {
      "id": "no-pro-by-default",
      "priority": 9,
      "text": "Never silently use paid or authenticated material."
    },
    {
      "id": "quality-over-effects",
      "priority": 10,
      "text": "Accessibility, responsiveness, performance and coherence outrank novelty."
    },
    {
      "id": "base-system-conflict",
      "priority": 11,
      "text": "An occupied exclusive role rejects a second owner unless an isolation strategy exists outside this recommendation."
    },
    {
      "id": "candidate-ranking",
      "priority": 12,
      "text": "Rank admissible candidates by policy order, installed evidence, bounded dependency and bundle cost, overlap, and declared version constraints."
    },
    {
      "id": "version-compatibility",
      "priority": 13,
      "text": "Reject a candidate when a supplied host version violates its bounded declared compatibility range."
    }
  ],
  "roles": {
    "base-system": {
      "description": "Semantic controls, themes and application primitives.",
      "exclusive": true,
      "host_profile_field": "design_system"
    },
    "product-polish": {
      "description": "Selective product surfaces compatible with the host base.",
      "exclusive": false
    },
    "data-visualization": {
      "description": "Charts, gauges, heatmaps and analytical graphics.",
      "exclusive": true,
      "host_profile_field": "chart_stack"
    },
    "marketing-enhancement": {
      "description": "Primary animated marketing layer.",
      "exclusive": true
    },
    "signature-effect": {
      "description": "One bounded creative effect.",
      "exclusive": true
    },
    "timeline-motion": {
      "description": "Bespoke timeline, SVG or scroll choreography.",
      "exclusive": true,
      "host_profile_field": "motion_stack"
    },
    "interactive-vector": {
      "description": "State-machine-driven vector graphics.",
      "exclusive": true
    }
  },
  "capability_routes": {
    "forms-controls": {
      "priority": 10,
      "role": "base-system",
      "candidates": ["daisyui"]
    },
    "product-polish": {
      "priority": 40,
      "role": "product-polish",
      "candidates": ["kokonut-ui", "daisyui"]
    },
    "data-visualization": {
      "priority": 20,
      "role": "data-visualization",
      "candidates": ["bklit-ui"]
    },
    "marketing-motion": {
      "priority": 30,
      "role": "marketing-enhancement",
      "candidates": ["magic-ui", "react-bits"]
    },
    "signature-creative-effect": {
      "priority": 50,
      "role": "signature-effect",
      "candidates": ["react-bits", "magic-ui"]
    },
    "bespoke-motion": {
      "priority": 60,
      "role": "timeline-motion",
      "candidates": ["animejs"]
    },
    "interactive-vector": {
      "priority": 70,
      "role": "interactive-vector",
      "candidates": ["rive"],
      "requirements": [
        {
          "field": "rive_asset_rights",
          "equals": "confirmed",
          "reason": "Rive asset rights must be confirmed for the exact .riv asset."
        }
      ]
    }
  },
  "candidate_profiles": {
    "kokonut-ui": {
      "dependency_cost": 1,
      "bundle_cost": 1,
      "package_names": [],
      "overlap_groups": ["shadcn-components", "product-ui"],
      "version_constraints": [
        {
          "host_field": "tailwind_version",
          "range": ">=4.0.0",
          "reason": "Current Kokonut UI guidance targets Tailwind CSS v4 hosts."
        }
      ]
    },
    "react-bits": {
      "dependency_cost": 1,
      "bundle_cost": 3,
      "package_names": [],
      "overlap_groups": ["creative-effects", "motion"]
    },
    "daisyui": {
      "dependency_cost": 2,
      "bundle_cost": 2,
      "package_names": ["daisyui"],
      "overlap_groups": ["base-system", "product-ui"],
      "version_constraints": [
        {
          "host_field": "tailwind_version",
          "range": ">=4.0.0",
          "reason": "Current daisyUI guidance targets Tailwind CSS v4 hosts."
        }
      ]
    },
    "bklit-ui": {
      "dependency_cost": 1,
      "bundle_cost": 2,
      "package_names": [],
      "overlap_groups": ["data-visualization", "shadcn-components"]
    },
    "animejs": {
      "dependency_cost": 2,
      "bundle_cost": 2,
      "package_names": ["animejs"],
      "overlap_groups": ["motion", "motion-engine"]
    },
    "rive": {
      "dependency_cost": 3,
      "bundle_cost": 5,
      "package_names": ["@rive-app/react-webgl2", "@rive-app/react-canvas"],
      "overlap_groups": ["motion", "vector-runtime"]
    },
    "magic-ui": {
      "dependency_cost": 1,
      "bundle_cost": 2,
      "package_names": [],
      "overlap_groups": ["creative-effects", "marketing-motion", "shadcn-components"]
    }
  },
  "host_conflicts": [
    {
      "rule_id": "base-system-conflict",
      "candidate": "daisyui",
      "field": "design_system",
      "patterns": ["shadcn", "radix"],
      "reason": "The host base system already owns semantic controls and themes."
    },
    {
      "rule_id": "base-system-conflict",
      "candidate": "kokonut-ui",
      "field": "design_system",
      "patterns": ["daisyui", "daisy ui"],
      "reason": "Kokonut is a shadcn-compatible layer and is not added on top of a daisyUI base without an isolation plan."
    }
  ],
  "selected_conflicts": [
    {
      "rule_id": "base-system-conflict",
      "libraries": ["daisyui", "kokonut-ui"],
      "reason": "daisyUI and Kokonut cannot both own component foundations in one unisolated plan."
    }
  ]
}
