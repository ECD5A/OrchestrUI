{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ECD5A/OrchestrUI/catalog/components.schema.json",
  "title": "OrchestrUI component discovery metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verified_at", "policy", "libraries"],
  "properties": {
    "schema_version": { "const": 1 },
    "verified_at": { "type": "string", "format": "date" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metadata_only", "public_sources_only", "max_live_response_bytes", "live_timeout_ms"],
      "properties": {
        "metadata_only": { "const": true },
        "public_sources_only": { "const": true },
        "max_live_response_bytes": { "type": "integer", "minimum": 1024, "maximum": 524288 },
        "live_timeout_ms": { "type": "integer", "minimum": 250, "maximum": 10000 }
      }
    },
    "libraries": {
      "type": "object",
      "minProperties": 7,
      "maxProperties": 7,
      "additionalProperties": { "$ref": "#/$defs/componentLibrary" }
    }
  },
  "$defs": {
    "componentLibrary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "items"],
      "properties": {
        "source": { "type": "string", "format": "uri", "pattern": "^https://" },
        "registry_index": { "type": "string", "format": "uri", "pattern": "^https://" },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "title", "description"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "description": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
