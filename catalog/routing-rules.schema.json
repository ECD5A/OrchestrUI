{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ECD5A/OrchestrUI/main/catalog/routing-rules.schema.json",
  "title": "OrchestrUI structured routing policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "rules", "roles", "capability_routes", "host_conflicts", "selected_conflicts"],
  "properties": {
    "schema_version": { "const": 2 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "priority", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "priority": { "type": "integer", "minimum": 1 },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    },
    "roles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description", "exclusive"],
        "properties": {
          "description": { "type": "string", "minLength": 1 },
          "exclusive": { "type": "boolean" },
          "host_profile_field": { "enum": ["design_system", "motion_stack", "chart_stack"] }
        }
      }
    },
    "capability_routes": {
      "type": "object",
      "minProperties": 7,
      "maxProperties": 7,
      "propertyNames": {
        "enum": [
          "forms-controls",
          "product-polish",
          "data-visualization",
          "marketing-motion",
          "signature-creative-effect",
          "bespoke-motion",
          "interactive-vector"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "role", "candidates"],
        "properties": {
          "priority": { "type": "integer", "minimum": 1 },
          "role": { "type": "string", "minLength": 1 },
          "candidates": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "requirements": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field", "equals", "reason"],
              "properties": {
                "field": { "const": "rive_asset_rights" },
                "equals": { "enum": ["confirmed", "unconfirmed", "not-applicable"] },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "host_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "candidate", "field", "patterns", "reason"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "candidate": { "type": "string", "minLength": 1 },
          "field": { "enum": ["design_system", "motion_stack", "chart_stack"] },
          "patterns": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "selected_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule_id", "libraries", "reason"],
        "properties": {
          "rule_id": { "type": "string", "minLength": 1 },
          "libraries": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
