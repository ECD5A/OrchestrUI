{
  "name": "orchestrui",
  "version": "0.2.1",
  "private": false,
  "description": "Deterministic UI policy, discovery and quality gates for coding agents",
  "type": "module",
  "license": "MIT",
  "author": "ECD5A",
  "homepage": "https://ecd5a.github.io/OrchestrUI/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ECD5A/OrchestrUI.git"
  },
  "bugs": {
    "url": "https://github.com/ECD5A/OrchestrUI/issues"
  },
  "keywords": [
    "mcp",
    "agent-skills",
    "ui",
    "ux",
    "frontend",
    "design-system"
  ],
  "mcpName": "io.github.ECD5A/orchestrui",
  "main": "./dist/mcp/src/server.js",
  "types": "./dist/mcp/src/server.d.ts",
  "bin": {
    "orchestrui-mcp": "./dist/mcp/src/server.js"
  },
  "files": [
    "dist/",
    "assets/",
    "benchmark/",
    "catalog/",
    "docs/",
    "examples/",
    ".agents/skills/",
    "skills/",
    ".codex-plugin/plugin.json",
    ".mcp.json",
    "server.json",
    "README.md",
    "README.ru.md",
    "LICENSE",
    "PRIVACY.md",
    "TERMS.md",
    "THIRD_PARTY.md",
    "SECURITY.md",
    "SUPPORT.md",
    "TRADEMARKS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test test/*.test.mjs",
    "benchmark": "npm run build --silent && node benchmark/run.mjs",
    "fixtures": "npm run build --silent && node examples/fixtures/run.mjs",
    "fixtures:write": "npm run build --silent && node examples/fixtures/run.mjs --write",
    "site:data": "node scripts/build-site-data.mjs",
    "site:data:write": "node scripts/build-site-data.mjs --write",
    "check": "npm run validate && npm run site:data && npm run typecheck && npm test",
    "check:links": "node scripts/check-external-links.mjs",
    "render:brand": "node scripts/render-brand-assets.mjs",
    "render:demo": "node scripts/render-readme-demo.mjs",
    "start:mcp": "node dist/mcp/src/server.js",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run check"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.20.1",
    "gifenc": "^1.0.3",
    "typescript": "^7.0.2"
  }
}
